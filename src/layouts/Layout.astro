---
interface Props {
  title?: string;
}
const { title = "yigit.club" } = Astro.props;
---

<!doctype html>
<html lang="tr" class="bg-[#faf8f5] text-[#1c1917] antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
      .font-serif-custom { font-family: 'Newsreader', Georgia, serif; }
    </style>
  </head>
  <body class="min-h-screen p-6 md:p-12 max-w-6xl mx-auto">
    <slot />
  </body>
</html>
