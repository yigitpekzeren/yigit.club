---
interface Props {
  title: string;
}
const { title } = Astro.props;
const allPosts = await Astro.glob('../pages/notlar/*.md');
const categories = [...new Set(allPosts.map((p) => p.frontmatter.category))].sort();
---
<!doctype html>
<html lang="tr" class="bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | yigit.club</title>
  </head>
  <body class="min-h-screen flex flex-col font-sans">
    <header class="border-b border-zinc-800/60 sticky top-0 bg-zinc-950/80 backdrop-blur-md z-50">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="font-semibold tracking-tight">yigit.club</a>
        <nav class="flex items-center gap-6 text-sm text-zinc-400">
          {categories.map((cat) => (
            <a href={"/kategori/" + cat} class="hover:text-zinc-100 capitalize">{cat}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="flex-grow max-w-4xl mx-auto px-6 py-12 w-full">
      <slot />
    </main>

    <footer class="border-t border-zinc-800/60 py-8 text-center text-xs text-zinc-500">
      <p>© 2026 — yigit.club</p>
    </footer>
  </body>
</html>
