---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="tr" class="bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | yigit.club</title>
  </head>
  <body class="min-h-screen p-6 max-w-4xl mx-auto">
    <slot />
  </body>
</html>
