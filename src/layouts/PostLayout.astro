---
import Layout from './Layout.astro';
const { frontmatter } = Astro.props;
---
<Layout title={frontmatter.title}>
  <article class="max-w-2xl mx-auto">
    <header class="mb-8 pb-8 border-b border-zinc-800">
      <div class="flex items-center gap-3 text-xs text-zinc-400 mb-4 font-mono">
        <span class="uppercase tracking-wider">{frontmatter.category}</span>
        <span>•</span>
        <span>{new Date(frontmatter.date).toLocaleDateString('tr-TR')}</span>
        <span>•</span>
        <span class="bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-full text-zinc-300">{frontmatter.stage}</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight">{frontmatter.title}</h1>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none text-zinc-300 leading-relaxed">
      <slot />
    </div>
  </article>
</Layout>
