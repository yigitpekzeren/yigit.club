---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const posts = await Astro.glob('./*.md');
const post = posts.find(p => p.file.endsWith(`${slug}.md`));

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = post;
const { title, date, category, subcategory, stage } = post.frontmatter;
---

<Layout title={title}>
  <article class="max-w-2xl mx-auto">
    <header class="mb-8 pb-8 border-b border-zinc-800">
      <div class="flex items-center gap-3 text-xs text-zinc-400 mb-4 font-mono">
        <span class="uppercase tracking-wider">{subcategory ? `${category} / ${subcategory}` : category}</span>
        <span>•</span>
        <span>{new Date(date).toLocaleDateString('tr-TR')}</span>
        <span>•</span>
        <span class="bg-zinc-900 border border-zinc-800 px-2.5 py-1 rounded-full text-zinc-300">
          {stage}
        </span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-100">{title}</h1>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none text-zinc-300 space-y-6 leading-relaxed">
      <Content />
    </div>
  </article>
</Layout>
