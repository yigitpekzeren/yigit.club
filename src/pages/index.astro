---
import Layout from '../../layouts/Layout.astro';

let isAuthenticated = false;
let errorMessage = '';
let successMessage = '';

// Cookie kontrolü
const cookieHeader = Astro.request.headers.get('cookie') || '';
const match = cookieHeader.match(/admin_auth=true/);
if (match) {
  isAuthenticated = true;
}

// Form gönderildiğinde (Giriş veya Yazı Kaydetme)
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');

  // 1. Giriş İşlemi
  if (action === 'login') {
    const password = formData.get('password');
    if (password === import.meta.env.ADMIN_PASSWORD) {
      isAuthenticated = true;
      // 1 günlük oturum çerezi set et
      Astro.response.headers.set('Set-Cookie', 'admin_auth=true; Path=/; HttpOnly; Secure; Max-Age=86400');
    } else {
      errorMessage = 'Hatalı şifre!';
    }
  }

  // 2. Yeni Yazı / Kayıt İşlemi (GitHub API ile Markdown Oluşturma)
  if (action === 'create_post' && isAuthenticated) {
    const title = formData.get('title')?.toString().trim();
    const category = formData.get('category')?.toString().trim();
    const subcategory = formData.get('subcategory')?.toString().trim() || '';
    const stage = formData.get('stage')?.toString();
    const content = formData.get('content')?.toString();

    if (!title || !category || !content) {
      errorMessage = 'Başlık, kategori ve içerik alanları zorunludur.';
    } else {
      // Dosya adı için URL dostu slug oluşturma
      const slug = title
        .toLowerCase()
        .replace(/ğ/g, 'g').replace(/ü/g, 'u').replace(/ş/g, 's')
        .replace(/ı/g, 'i').replace(/ö/g, 'o').replace(/ç/g, 'c')
        .replace(/[^a-z0-9]/g, '-')
        .replace(/-+/g, '-');

      const date = new Date().toISOString().split('T')[0];
      const filePath = `src/pages/notlar/${slug}.md`;

      // Markdown dosya içeriği
      const fileContent = `---
layout: "../../layouts/Layout.astro"
title: "${title}"
date: ${date}
category: "${category}"
subcategory: "${subcategory}"
stage: "${stage}"
---

${content}
`;

      // GitHub API İstek Detayları
      const repo = 'yigitpekzeren/yigit.club';
      const token = import.meta.env.GITHUB_TOKEN;
      const url = `https://api.github.com/repos/${repo}/contents/${filePath}`;

      try {
        const response = await fetch(url, {
          method: 'PUT',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28'
          },
          body: JSON.stringify({
            message: `Yeni yazı eklendi: ${title}`,
            content: Buffer.from(fileContent).toString('base64'),
            branch: 'main'
          })
        });

        if (response.ok) {
          successMessage = 'Yazı başarıyla oluşturuldu ve GitHub\'a kaydedildi! Vercel birazdan yayına alacak.';
        } else {
          const errData = await response.json();
          errorMessage = `GitHub Kayıt Hatası: ${errData.message || 'Bilinmeyen hata'}`;
        }
      } catch (err) {
        errorMessage = 'Bağlantı hatası oluştu.';
      }
    }
  }
}
---

<Layout title="Yönetim Paneli">
  <div class="max-w-xl mx-auto py-8">
    <h1 class="text-2xl font-bold tracking-tight mb-6">Yönetim Tezgâhı</h1>

    {errorMessage && (
      <div class="bg-red-950/50 border border-red-800 text-red-200 px-4 py-3 rounded-xl mb-6 text-sm">
        {errorMessage}
      </div>
    )}

    {successMessage && (
      <div class="bg-emerald-950/50 border border-emerald-800 text-emerald-200 px-4 py-3 rounded-xl mb-6 text-sm">
        {successMessage}
      </div>
    )}

    {!isAuthenticated ? (
      <!-- Giriş Formu -->
      <form method="POST" class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl space-y-4">
        <input type="hidden" name="action" value="login" />
        <div>
          <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">Admin Şifresi</label>
          <input 
            type="password" 
            name="password" 
            required 
            class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 focus:outline-none focus:border-zinc-600"
            placeholder="Şifrenizi girin..."
          />
        </div>
        <button type="submit" class="w-full bg-zinc-100 text-zinc-950 font-medium py-2.5 rounded-xl hover:bg-zinc-200 transition-colors">
          Giriş Yap
        </button>
      </form>
    ) : (
      <!-- Yazı Ekleme Formu -->
      <form method="POST" class="bg-zinc-900 border border-zinc-800 p-6 rounded-2xl space-y-4">
        <input type="hidden" name="action" value="create_post" />

        <div>
          <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">Yazı Başlığı</label>
          <input type="text" name="title" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 focus:outline-none focus:border-zinc-600" />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">Kategori</label>
            <input type="text" name="category" placeholder="örn: miras, hobiler" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 focus:outline-none focus:border-zinc-600" />
          </div>
          <div>
            <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">Alt Kategori (İsteğe bağlı)</label>
            <input type="text" name="subcategory" placeholder="örn: arkeoloji, saatler" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 focus:outline-none focus:border-zinc-600" />
          </div>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">Kahve Aşaması</label>
          <select name="stage" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 focus:outline-none focus:border-zinc-600">
            <option value="🫘 Çekirdek">🫘 Çekirdek (Taslak)</option>
            <option value="⏳ Demleniyor">⏳ Demleniyor (Üzerinde çalışılıyor)</option>
            <option value="☕ Fincanda">☕ Fincanda (Tamamlandı)</option>
          </select>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider font-mono text-zinc-400 mb-2">İçerik (Markdown)</label>
          <textarea name="content" rows="8" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-4 py-2.5 text-zinc-100 font-mono text-sm focus:outline-none focus:border-zinc-600"></textarea>
        </div>

        <button type="submit" class="w-full bg-zinc-100 text-zinc-950 font-medium py-2.5 rounded-xl hover:bg-zinc-200 transition-colors">
          Yazıyı Yayınla (GitHub'a Kaydet)
        </button>
      </form>
    )}
  </div>
</Layout>
