---
import Layout from '../layouts/Layout.astro';
const allPosts = await Astro.glob('./notlar/*.md');
// Tarihe göre yeniden eskiye sıralama
const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());
---

<Layout title="Ana Sayfa">
  <section class="mb-12">
    <h1 class="text-2xl font-bold tracking-tight mb-2">Dijital Tezgâh</h1>
    <p class="text-sm text-zinc-400">Düşünceler, taslaklar ve demlenen yazılar.</p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {sortedPosts.map((post, index) => (
      <a 
        href={post.url} 
        class={`group relative bg-zinc-900 border border-zinc-800/80 rounded-2xl p-6 flex flex-col justify-between overflow-hidden hover:border-zinc-700 transition-all duration-300 min-h-[200px] ${index === 0 ? 'md:col-span-2 md:row-span-1' : ''}`}
      >
        <div class="flex items-center justify-between text-xs text-zinc-400 mb-4">
          <span class="uppercase tracking-wider font-mono">
            {post.frontmatter.subcategory ? `${post.frontmatter.category} / ${post.frontmatter.subcategory}` : post.frontmatter.category}
          </span>
          <span class="bg-zinc-800/80 px-2.5 py-1 rounded-full text-zinc-300">
            {post.frontmatter.stage}
          </span>
        </div>

        <div>
          <h2 class="text-lg font-medium text-zinc-100 group-hover:translate-y-[-2px] transition-transform duration-300">
            {post.frontmatter.title}
          </h2>
          <p class="text-xs text-zinc-500 mt-2 font-mono">
            {new Date(post.frontmatter.date).toLocaleDateString('tr-TR')}
          </p>
        </div>

        <div class="absolute inset-0 bg-gradient-to-t from-zinc-800/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
      </a>
    ))}
  </div>
</Layout>
