---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const allPosts = await Astro.glob('../notlar/*.md');
const posts = allPosts.filter(
  (p) => p.frontmatter.category?.toLowerCase() === slug?.toLowerCase()
);
const pageTitle = "Kategori: " + slug;

export async function getStaticPaths() {
  return [
    { params: { slug: 'miras' } },
    { params: { slug: 'hobiler' } },
    { params: { slug: 'atolye' } },
    { params: { slug: 'genel' } }
  ];
}
---

<Layout title={pageTitle}>
  <header class="mb-10">
    <h1 class="text-2xl font-bold tracking-tight uppercase mb-2">{slug}</h1>
    <p class="text-sm text-zinc-400">Bu kategori altındaki tüm yazılar.</p>
  </header>

  {posts.length === 0 ? (
    <p class="text-zinc-500 text-sm">Bu kategoride henüz yazı yok.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {posts.map((post) => (
        
          href={post.url}
          class="group relative bg-zinc-900 border border-zinc-800/80 rounded-2xl p-6 flex flex-col justify-between overflow-hidden hover:border-zinc-700 hover:-translate-y-1 transition-all duration-300 min-h-[180px]"
        >
          <div class="flex items-center justify-between text-xs text-zinc-400 mb-4">
            <span class="uppercase tracking-wider font-mono">{post.frontmatter.category}</span>
            <span class="bg-zinc-800/80 px-2.5 py-1 rounded-full text-zinc-300">{post.frontmatter.stage}</span>
          </div>
          <div>
            <h2 class="text-lg font-medium text-zinc-100">{post.frontmatter.title}</h2>
            <p class="text-xs text-zinc-500 mt-2 font-mono">{new Date(post.frontmatter.date).toLocaleDateString('tr-TR')}</p>
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
