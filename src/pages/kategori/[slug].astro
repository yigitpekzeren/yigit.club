---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const allPosts = await Astro.glob('../notlar/*.md');
const posts = allPosts.filter(p => p.frontmatter.category?.toLowerCase() === slug?.toLowerCase());
---

<Layout title={`Kategori: ${slug}`}>
  <section class="mb-12">
    <h1 class="text-2xl font-bold tracking-tight uppercase mb-2">Kategori: {slug}</h1>
    <p class="text-sm text-zinc-400">Bu kategori altındaki tüm demlenen içerikler.</p>
  </section>

  {posts.length === 0 ? (
    <p class="text-zinc-500 text-sm">Bu kategoride henüz yazı bulunmuyor.</p>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {posts.map((post) => (
        <a 
          href={post.url} 
          class="group relative bg-zinc-900 border border-zinc-800/80 rounded-2xl p-6 flex flex-col justify-between overflow-hidden hover:border-zinc-700 transition-all duration-300 min-h-[200px]"
        >
          <div class="flex items-center justify-between text-xs text-zinc-400 mb-4">
            <span class="uppercase tracking-wider font-mono">
              {post.frontmatter.subcategory ? `${post.frontmatter.category} / ${post.frontmatter.subcategory}` : post.frontmatter.category}
            </span>
            <span class="bg-zinc-800/80 px-2.5 py-1 rounded-full text-zinc-300">
              {post.frontmatter.stage}
            </span>
          </div>

          <div>
            <h2 class="text-lg font-medium text-zinc-100 group-hover:translate-y-[-2px] transition-transform duration-300">
              {post.frontmatter.title}
            </h2>
            <p class="text-xs text-zinc-500 mt-2 font-mono">
              {new Date(post.frontmatter.date).toLocaleDateString('tr-TR')}
            </p>
          </div>
        </a>
      ))}
    </div>
  )}
</Layout>
